# =============================================================================
# SOT Analyzer - environment template
# Copy to `.env` and fill in real values.  NEVER commit `.env`.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development           # development | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                    # true in production for structured log shipping

# --- PostgreSQL ------------------------------------------------------------
# These three are consumed by the `db` service in docker-compose.yml.
POSTGRES_USER=sot
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=sot_analyzer
POSTGRES_HOST=db                  # use `localhost` when running the API outside Docker
POSTGRES_PORT=5432

# Optional: full override. If set, it wins over the POSTGRES_* parts above.
# Must use the async driver: postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://sot:change_me@localhost:5432/sot_analyzer

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api

# Comma-separated list of allowed browser origins. Do NOT use "*" in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for Netlify deploy-preview URLs. Keep the production site in
# CORS_ORIGINS and scope this to your exact Netlify site name.
# CORS_ORIGIN_REGEX=^https://deploy-preview-[0-9]+--YOUR-SITE\.netlify\.app$

# --- Admin / ingestion protection -----------------------------------------
# Guards every POST /api/admin/* route via the X-Admin-Token header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=change_me_generate_a_long_random_token

# --- Football data provider (server-side only, never exposed to browser) ----
# The provider adapter is selected by name; "fake" needs no credentials and is
# used for local development and tests.
FOOTBALL_PROVIDER=fake            # fake | apifootball | statsbomb | sportsapipro
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
# SportsAPI Pro supports all seven tracked leagues plus Leagues Cup.
SPORTS_API_PRO_KEY=
SPORTS_API_PRO_BASE_URL=https://v2.football.sportsapipro.com
# Completed-match pages fetched per league (30 matches/page). Keep at 1 on the free plan.
SPORTS_API_PRO_HISTORY_PAGES=1
# Client-side throttle. Keep at or below your plan's documented limit.
# Free plan: 10/min. Paid plans may raise this to their documented allowance.
FOOTBALL_API_RATE_LIMIT_PER_MINUTE=10
FOOTBALL_API_TIMEOUT_SECONDS=20
FOOTBALL_API_MAX_RETRIES=4

# --- Analytics defaults ----------------------------------------------------
DEFAULT_MIN_STARTS_FOR_RANKING=5
EARLY_EXIT_MINUTES_THRESHOLD=45

# --- Frontend --------------------------------------------------------------
# NEXT_PUBLIC_* is compiled into the browser bundle. Only put non-secret
# values here. The provider API key must never appear with this prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Optional canonical site URL. Netlify supplies its own URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
